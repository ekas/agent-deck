<Window x:Class="AgentDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentDeck.App"
        Title="Agent Deck (.NET)"
        Width="260" Height="520"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        Der Fenstertitel ist bewusst von der Python-Fassung unterscheidbar: solange
        beide parallel laufen, hießen sonst zwei Fenster "Agent Deck" - und
        win_focus.py sucht Fenster per Titel.

        Aufbau wie im Original: eine Spalte Kacheln, unten die Dauer-Leiste
        (Usage links, Einstellungen rechts). Der Voll-Modus mit Header und
        Button-Raster ist bewusst nicht portiert - er wurde in der Python-Fassung
        2026-07-22 komplett entfernt.
    -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <ItemsControl x:Name="TileList" ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TileViewModel}">
                        <!-- Abstand = GRID_GAP aus config.py -->
                        <Border Style="{StaticResource TileCard}"
                                Background="{Binding Fill}"
                                Margin="0,0,0,8"
                                Cursor="Hand"
                                AllowDrop="True"
                                Tag="{Binding Slot}"
                                PreviewMouseLeftButtonDown="Tile_MouseDown"
                                PreviewMouseMove="Tile_MouseMove"
                                PreviewMouseLeftButtonUp="Tile_MouseUp"
                                Drop="Tile_Drop"
                                DragOver="Tile_DragOver">

                            <Border.Effect>
                                <DropShadowEffect Color="{Binding GlowColor}"
                                                  BlurRadius="{Binding GlowRadius}"
                                                  Opacity="{Binding GlowOpacity}"
                                                  ShadowDepth="0"/>
                            </Border.Effect>

                            <!--
                                Hover zeigt, worauf sich der Chat bezieht (Ticket/PR) und
                                die zuletzt gestellte Frage. Die KI-Kurzzusammenfassung
                                der Python-Fassung fehlt noch - sie ruft `claude` als
                                Unterprozess auf und ist kein Oberflächen-Thema.
                            -->
                            <!--
                                Rechtsklick bündelt die Slot-Aktionen (wie das
                                Kontextmenü der Python-Fassung). Ticket-Zuweisung und
                                Effort fehlen noch - beides hängt an Backend-Teilen,
                                die nicht portiert sind.
                            -->
                            <Border.ContextMenu>
                                <ContextMenu Tag="{Binding Slot}">
                                    <MenuItem Header="Modus · manual" Tag="manual" Click="Mode_Click"/>
                                    <MenuItem Header="Modus · accept" Tag="accept" Click="Mode_Click"/>
                                    <MenuItem Header="Modus · plan" Tag="plan" Click="Mode_Click"/>
                                    <MenuItem Header="Modus · auto" Tag="auto" Click="Mode_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Modell · opus[1m]" Tag="opus[1m]" Click="Model_Click"/>
                                    <MenuItem Header="Modell · opus" Tag="opus" Click="Model_Click"/>
                                    <MenuItem Header="Modell · sonnet" Tag="sonnet" Click="Model_Click"/>
                                    <MenuItem Header="Modell · fable" Tag="fable" Click="Model_Click"/>
                                    <Separator/>
                                    <MenuItem Header="/clear" Tag="/clear" Click="Send_Click"/>
                                    <MenuItem Header="Agent schließen" Click="CloseAgent_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Border.ToolTip>
                                <ToolTip Background="#FF1A1A22" BorderBrush="#FF33333D"
                                         Foreground="{StaticResource Ink2}" MaxWidth="340">
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Reference}"
                                                   Foreground="#FFB39DDB" FontSize="11"
                                                   FontWeight="SemiBold" Margin="0,0,0,4"
                                                   Visibility="{Binding HasReference,
                                                       Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding Slot}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" FontSize="12"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{StaticResource Ink3}" Margin="0,1,0,0"/>
                                        <TextBlock Text="{Binding TooltipBody}" TextWrapping="Wrap"
                                                   FontSize="11" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Slot}" Style="{StaticResource SlotLabel}"/>
                                        <!-- Erkannter Bezug, gedimmt auf der Karte -->
                                        <TextBlock Text="{Binding Reference}" FontSize="10"
                                                   Foreground="#FF6E6A85" Margin="6,2,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SubLine}" Style="{StaticResource ActivityLabel}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Statuspunkt in der Statusfarbe -->
                                <Ellipse Grid.Column="1" Width="8" Height="8"
                                         VerticalAlignment="Top" Margin="6,4,0,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding GlowColor}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                Je verbundenem Fenster eine ＋-Kachel: ein Klick öffnet dort einen
                weiteren Claude-Chat. Sie stehen unter den Kacheln, damit klar ist,
                wohin der neue Chat gehört.
            -->
            <ItemsControl ItemsSource="{Binding AddTiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:AddTileViewModel}">
                        <Border CornerRadius="10" BorderThickness="1"
                                BorderBrush="#FF2C2C36" Background="#FF191921"
                                Padding="10,8" Margin="0,0,0,8" Cursor="Hand"
                                Tag="{Binding Window}"
                                MouseLeftButtonUp="AddTile_Click">
                            <TextBlock Text="{Binding Caption}" FontSize="12"
                                       Foreground="{StaticResource Ink3}"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Bottom-Bar: eine durchgehende Fläche, flächenbündig wie bottom_bar.py -->
        <Border Grid.Row="1" Background="#FF1A1A22" CornerRadius="8" Padding="10,6" Margin="0,4,0,0">
            <Grid>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource BottomText}"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="SettingsButton" Text="⚙" Style="{StaticResource BottomText}"
                           HorizontalAlignment="Right" FontSize="13" Cursor="Hand"
                           MouseLeftButtonUp="Settings_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
