<Window x:Class="AgentDeck.App.HandleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Deck Griff"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Focusable="False"
        ShowActivated="False">

    <!--
        Der Griff ist eine freistehende Kapsel. In WPF genügt dafür AllowsTransparency
        (Per-Pixel-Alpha kommt vom Compositor) - die Python-Fassung musste dafür selbst
        UpdateLayeredWindow bedienen, samt der Falle, dass withdraw/deiconify den
        Layer-Zustand verwirft.

        Das Fenster ist ABSICHTLICH größer als die Kapsel: der Schein braucht Platz,
        sonst schneidet der Fensterrand den Bloom-Schweif zu einem Kasten ab
        (HANDLE_PAD im Original).
    -->
    <Grid>
        <Border x:Name="Capsule"
                Background="{Binding NeonBrush}"
                CornerRadius="{Binding CapsuleRadius}"
                Margin="{Binding CapsuleMargin}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="{Binding NeonColor}"
                                  BlurRadius="{Binding BloomRadius}"
                                  Opacity="{Binding BloomOpacity}"
                                  ShadowDepth="0"/>
            </Border.Effect>
        </Border>
    </Grid>
</Window>
