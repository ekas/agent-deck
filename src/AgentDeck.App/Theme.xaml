<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Blendet den Bezug aus, wenn dem Slot kein Ticket zugewiesen ist. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!--
        Die Palette aus canvas_kit.py, unverändert übernommen. Wer hier Farben
        anfasst, ändert die Deck-Optik an EINER Stelle.
    -->
    <Color x:Key="BgColor">#FF121218</Color>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>

    <!-- Graphit-Basis der Kachel (idle/none); der Status tönt sie ein. -->
    <SolidColorBrush x:Key="CardFill" Color="#FF23232B"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FF33333D"/>

    <SolidColorBrush x:Key="Ink" Color="#FFEDEDF2"/>      <!-- Haupttext -->
    <SolidColorBrush x:Key="Ink2" Color="#FFCFD3DC"/>     <!-- Sekundärtext -->
    <SolidColorBrush x:Key="Ink3" Color="#FF8B8B99"/>     <!-- Hinweise, dezente Icons -->

    <!-- Maße: GRID_GAP kommt aus config.py; der Rest ist bewusst neu justiert,
         weil das WPF-Rendering nicht pixelgleich zum Pillow-Original ist. -->
    <system:Double x:Key="GridGap" xmlns:system="clr-namespace:System;assembly=System.Runtime">8</system:Double>

    <!--
        Kachel: abgerundete Fläche mit farbigem Schein. Der Schein ist ein
        DropShadowEffect mit ShadowDepth=0 - das ist in WPF der übliche Weg für
        einen Glow und läuft auf der GPU, anders als die von Hand komponierten
        Halo-Bitmaps der Python-Fassung.
    -->
    <Style x:Key="TileCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="SlotLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style x:Key="ActivityLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!--
        Dunkles Kontextmenü. WPF-Menüs holen ihre Farben aus SystemColors, darum werden
        genau die Schlüssel überschrieben - das ist deutlich weniger fehleranfällig, als
        ein vollständiges ControlTemplate für MenuItem samt Untermenü-Popup nachzubauen.
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#FF1A1A22"/>
        <Setter Property="Foreground" Value="#FFEDEDF2"/>
        <Setter Property="BorderBrush" Value="#FF33333D"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <!--
            Eigenes Template, weil das Standard-Menü links eine helle Icon-Spalte malt,
            deren Farbe HART KODIERT ist (nicht über SystemColors erreichbar). Deshalb
            ist das Menü auch flach statt verschachtelt: Untermenüs sind eigene Popups
            mit demselben Streifen, den man nur über ein vollständiges MenuItem-Template
            loswürde.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="3">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FFEDEDF2"/>
    </Style>

    <!--
        Die Farbschlüssel stehen im Wörterbuch selbst, NICHT in einem Style-Setter:
        Resources ist keine DependencyProperty, ein <Setter Property="Resources"> wirft
        beim Laden des Templates.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF1A1A22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFEDEDF2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#FF2C2C3A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF2C2C3A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFEDEDF2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF1A1A22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFEDEDF2"/>
    <!-- Die Icon-/Häkchen-Spalte am linken Menürand hängt an MenuBarBrushKey; ohne
         diesen Eintrag bleibt dort ein heller Streifen stehen. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF1A1A22"/>

    <Style x:Key="BottomText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
